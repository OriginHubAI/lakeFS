# ============================================
# lakeFS 部署配置 - 复制此文件为 .env 并修改
# ============================================

# ----------------
# PostgreSQL 配置
# ----------------
POSTGRES_USER=lakefs
POSTGRES_PASSWORD=lakefs123
POSTGRES_DB=lakefs
POSTGRES_PORT=5432

# ----------------
# MinIO 配置
# ----------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ----------------
# lakeFS 配置
# ----------------
LAKEFS_PORT=8000
# 重要：生产环境请修改为随机的32字符密钥
LAKEFS_AUTH_ENCRYPT_SECRET_KEY=your-production-secret-key-32ch
